# Chaîne de connexion Neon Postgres. Injectée par l'intégration Marketplace sur Vercel.
# Sans elle, les groupes vivent en mémoire et disparaissent avec le processus (dev, tests).
DATABASE_URL=

# Secret de signature des cookies de session des groupes. 32 octets aléatoires, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sans lui, un secret temporaire est tiré au démarrage : les sessions ne survivent pas à un redémarrage.
SESSION_SECRET=
