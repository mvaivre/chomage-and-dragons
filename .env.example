# Chaîne de connexion Neon Postgres. Injectée par l'intégration Marketplace sur Vercel.
# Obligatoire en production. En dev/tests sans elle : base mémoire isolée.
# Ne jamais copier la connexion de production dans l'environnement local/de test.
DATABASE_URL=

# Secret de signature des cookies de session des groupes. 32 octets aléatoires, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Obligatoire en production ; conserver sa valeur entre les déploiements.
SESSION_SECRET=

# Pour un build de production testé uniquement en local, sans DATABASE_URL :
# ALLOW_IN_MEMORY_DB=1
# Cette option est refusée sur Vercel.
